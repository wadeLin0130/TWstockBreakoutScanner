# 富果 API (Fugle) - 可選，如果還在使用舊版 Fugle 相關程式
FUGLE_API_KEY="YOUR_FUGLE_API_KEY_HERE"

# Google Gemini API
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Firebase Realtime Database URL (公開讀取，後端寫入)
FIREBASE_RTDB_URL=https://your-project-default-rtdb.firebaseio.com/

# 注意：
# 1. 複製此檔案為 .env 並填入真實金鑰
# 2. serviceAccountKey.json 請從 Firebase Console 下載，不要提交到 git
